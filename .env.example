# PostgreSQL
POSTGRES_USER=capybarca
POSTGRES_PASSWORD=changeme
POSTGRES_DB=capybarca_db

# Ports
PORT_DB=5432
PORT_BACKEND=8000
PORT_FRONTEND=5173

# FastAPI
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${PORT_DB}/${POSTGRES_DB}
SECRET_KEY=changeme
DEBUG=false

# Network
TAILSCALE_IP=

# User management
# Set to true to allow self-registration via the login page.
# The first admin account is always created via the setup flow, regardless of this setting.
ALLOW_NEW_USERS=true
