# PostgreSQL
POSTGRES_USER=capybarca
POSTGRES_PASSWORD=changeme
POSTGRES_DB=capybarca_db

# Ports
PORT_DB=5432
PORT_BACKEND=8000
PORT_FRONTEND=5173

# FastAPI
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
SECRET_KEY=changeme
DEBUG=false

# Database connection pool (optional). Defaults: 10 kept open, up to 30 more
# under load, matching the backend's 40 worker threads.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=30

# Network
TAILSCALE_IP=

# User management
# Set to true to allow self-registration via the login page.
# The first admin account is always created via the setup flow, regardless of this setting.
ALLOW_NEW_USERS=true
